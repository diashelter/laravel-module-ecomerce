# Variables used by docker-compose.yml.
# The Laravel configuration lives in backend/.env (copied from backend/.env.example).

# Port where the whole application is served by Nginx: http://localhost:8080
APP_PORT=8080

# PostgreSQL credentials (must match backend/.env)
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret

# Port exposed on the host to connect with a database client (optional)
DB_FORWARD_PORT=5433

# RabbitMQ credentials (must match backend/.env) and the port of the management UI on the host
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=secret
RABBITMQ_MANAGEMENT_PORT=15672

# MongoDB credentials (must match backend/.env) and the port exposed on the host to connect with a client (optional)
MONGODB_USERNAME=ecommerce
MONGODB_PASSWORD=secret
MONGODB_FORWARD_PORT=27018

# Database of `make test` in this checkout (optional, read only by the Makefile). Unset, it is
# ecommerce_testing in the main checkout and ecommerce_testing_<worktree name> in a git worktree.
# TEST_DB_DATABASE=ecommerce_testing
